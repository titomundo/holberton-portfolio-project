classDiagram
    class User {
        +UUID id
        +String firstName
        +String lastName
        +String email
        +String password
        +Boolean isAdmin
        +DateType created_at
        +DateType updated_at
        +get()
        +create()
        +delete()
        +update()
        +locations()
        +businesses()
        +as_dict()
    }

    class Role {
        +UUID isAdmin
        +String name
        +String description
        +get()
        +create()
        +delete()
        +update()
        +get_name()
        +as_dict()
    }

    class Business {
        +UUID id
        +String name
        +String description
        +String email
        +Integer phone_number
        +UUID user - user_id
        +DateType created_at
        +DateType updated_at
        +get()
        +create()
        +delete()
        +update()
        +locations()
        +as_dict()
    }

    class Location {
        +UUID id
        +String name
        +Integer capacity
        +String description
        +UUID business - business_id
        +UUID owner - user_id
        +DateType created_at
        +DateType updated_at
        +get()
        +create()
        +update()
        +delete()
        +reservations()
        +users()
        +as_dict()
    }

    class Reservation {
        +UUID id
        +UUID location_id
        +UUID user_id
        +String client_name
        +DateType date
        +String reason
        +Int slots
        +String status
        +DateType created_at
        +DateType updated_at
        +get()
        +create()
        +update()
        +delete()
        +as_dict()
    }

